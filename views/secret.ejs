<!DOCTYPE html>
<html lang="en">
<head>
  <% pageTitle = 'two two' %>
  <%- include('partials/head') %>
  <meta name="robots" content="noindex, nofollow">
</head>
<body>
  <%- include('partials/nav') %>

  <main class="bbs-shell">
    <header class="bbs-intro secret-intro">
      <div class="bbs-kicker">you found it</div>
      <h1>a secret gift for you</h1>
      <p>if your reading this, you bought the vinyl.

two songs that aren't anywhere else — a small thank you, just for you. please keep it our secret.

love, two two</p>
    </header>

    <div class="player-panel secret-player">
      <div class="bbs-kicker">two special songs</div>
      <%- include('partials/audio-player', { tracks: tracks, emptyMessage: 'the two songs will be here once they are uploaded from admin.' }) %>
      <% if (bundle) { %>
        <div class="secret-download">
          <div class="bbs-kicker">for you to keep</div>
          <p class="now-playing">the songs, and a few other bits.</p>
          <a class="btn" href="/secretgiftforyou/download">download</a>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
