<div class="now-playing" id="now-playing"><%= tracks.length ? 'select a track' : (typeof emptyMessage !== 'undefined' ? emptyMessage : 'no tracks yet.') %></div>

<audio id="player" preload="metadata"></audio>

<div class="player-controls">
  <button type="button" class="btn" id="prev-btn">prev</button>
  <button type="button" class="btn" id="play-btn">play</button>
  <button type="button" class="btn" id="next-btn">next</button>
</div>

<div class="player-progress">
  <span id="time-current">0:00</span>
  <input type="range" id="seek" min="0" max="100" value="0" step="0.1">
  <span id="time-total">0:00</span>
</div>

<ol class="track-list" id="track-list">
  <% if (tracks.length === 0) { %>
    <li><span class="track-item" style="cursor:default;">waiting for songs</span></li>
  <% } else { %>
    <% tracks.forEach(function(track, i) { %>
      <li>
        <button
          type="button"
          class="track-item"
          data-index="<%= i %>"
          data-src="/uploads/mp3/<%= track.filename %>"
          data-title="<%= track.title %>"
        >
          <span class="track-num">#<%= String(i + 1).padStart(6, '0') %></span>
          <span class="track-name"><%= track.title %></span>
        </button>
      </li>
    <% }); %>
  <% } %>
</ol>

<script>
  (function () {
    const audio = document.getElementById('player');
    const playBtn = document.getElementById('play-btn');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const seek = document.getElementById('seek');
    const nowPlaying = document.getElementById('now-playing');
    const timeCurrent = document.getElementById('time-current');
    const timeTotal = document.getElementById('time-total');
    const items = Array.from(document.querySelectorAll('.track-item[data-src]'));
    let index = 0;
    let seeking = false;

    function formatTime(sec) {
      if (!isFinite(sec)) return '0:00';
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return m + ':' + String(s).padStart(2, '0');
    }

    function setActive(i) {
      items.forEach(function (el, n) {
        el.classList.toggle('is-active', n === i);
      });
    }

    function loadTrack(i, autoplay) {
      if (!items.length) return;
      index = (i + items.length) % items.length;
      const item = items[index];
      audio.src = item.dataset.src;
      nowPlaying.textContent = 'now playing — ' + item.dataset.title;
      setActive(index);
      seek.value = 0;
      timeCurrent.textContent = '0:00';
      timeTotal.textContent = '0:00';
      if (autoplay) {
        audio.play().then(function () {
          playBtn.textContent = 'pause';
        }).catch(function () {
          playBtn.textContent = 'play';
        });
      } else {
        playBtn.textContent = 'play';
      }
    }

    playBtn.addEventListener('click', function () {
      if (!items.length) return;
      if (!audio.src) loadTrack(index, true);
      else if (audio.paused) {
        audio.play();
        playBtn.textContent = 'pause';
      } else {
        audio.pause();
        playBtn.textContent = 'play';
      }
    });

    prevBtn.addEventListener('click', function () {
      loadTrack(index - 1, true);
    });

    nextBtn.addEventListener('click', function () {
      loadTrack(index + 1, true);
    });

    items.forEach(function (item) {
      item.addEventListener('click', function () {
        loadTrack(Number(item.dataset.index), true);
      });
    });

    audio.addEventListener('loadedmetadata', function () {
      timeTotal.textContent = formatTime(audio.duration);
    });

    audio.addEventListener('timeupdate', function () {
      if (seeking || !audio.duration) return;
      seek.value = (audio.currentTime / audio.duration) * 100;
      timeCurrent.textContent = formatTime(audio.currentTime);
    });

    audio.addEventListener('ended', function () {
      loadTrack(index + 1, true);
    });

    seek.addEventListener('pointerdown', function () { seeking = true; });
    seek.addEventListener('pointerup', function () {
      if (audio.duration) audio.currentTime = (seek.value / 100) * audio.duration;
      seeking = false;
    });
    seek.addEventListener('change', function () {
      if (audio.duration) audio.currentTime = (seek.value / 100) * audio.duration;
      seeking = false;
    });

    loadTrack(0, false);
  })();
</script>
