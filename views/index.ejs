<!DOCTYPE html>
<html lang="en">
<head>
  <% pageTitle = 'two two' %>
  <%- include('partials/head') %>
</head>
<body class="home-only">
  <%- include('partials/nav') %>
  <canvas id="draw-board" aria-label="draw on the page"></canvas>
  <div class="brush-tray" id="brush-tray" aria-label="brushes">
    <button type="button" class="brush-btn is-active" data-brush="pencil" title="pencil">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l2.2-7.4 9.2-9.2 5.2 5.2-9.2 9.2zM15.2 5.6l3.2 3.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
    </button>
    <button type="button" class="brush-btn" data-brush="ink" title="ink">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5.5" fill="currentColor"/></svg>
    </button>
    <button type="button" class="brush-btn" data-brush="chalk" title="chalk">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="10" r="2.1" fill="currentColor"/><circle cx="13" cy="8" r="1.5" fill="currentColor"/><circle cx="15" cy="13" r="2.4" fill="currentColor"/><circle cx="10" cy="15" r="1.7" fill="currentColor"/></svg>
    </button>
    <button type="button" class="brush-btn" data-brush="spray" title="spray">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7" cy="8" r="1" fill="currentColor"/><circle cx="12" cy="6" r="1.1" fill="currentColor"/><circle cx="17" cy="9" r=".9" fill="currentColor"/><circle cx="9" cy="13" r="1.2" fill="currentColor"/><circle cx="15" cy="14" r="1" fill="currentColor"/><circle cx="12" cy="17" r=".8" fill="currentColor"/></svg>
    </button>
    <button type="button" class="brush-btn" data-brush="dots" title="dots">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7" cy="12" r="2" fill="currentColor"/><circle cx="12" cy="12" r="2" fill="currentColor"/><circle cx="17" cy="12" r="2" fill="currentColor"/></svg>
    </button>
    <button type="button" class="brush-btn" data-brush="splat" title="splat">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5c2 0 3 2 4 3 2 0 3 2 2 4 2 1 1 3-1 4 0 2-2 3-4 2-1 2-3 2-4 0-2 1-4 0-4-2-2-1-2-3 0-4 0-2 2-3 4-3 1-2 2-4 3-4z" fill="currentColor"/></svg>
    </button>
    <button type="button" class="brush-btn" data-brush="two" title="2">
      <span class="brush-two">2</span>
    </button>
  </div>
  <button type="button" class="graffiti-save" id="graffiti-save" hidden>save</button>
  <script>
    (function () {
      const canvas = document.getElementById('draw-board');
      const saveBtn = document.getElementById('graffiti-save');
      const ctx = canvas.getContext('2d');
      let brush = 'pencil';
      let drawing = false;
      let lastX = 0;
      let lastY = 0;
      let lastStampX = 0;
      let lastStampY = 0;
      let savedStrokes = [];
      let unsavedStrokes = [];
      let currentStroke = null;

      const stampGap = {
        pencil: 0,
        ink: 0,
        marker: 0,
        nib: 3,
        chalk: 4,
        spray: 6,
        dots: 14,
        stars: 16,
        splat: 18,
        bloom: 22,
        two: 16,
      };

      function hash(x, y, i) {
        const n = Math.sin(x * 127.1 + y * 311.7 + i * 74.7) * 43758.5453;
        return n - Math.floor(n);
      }

      function styleLine(kind) {
        ctx.strokeStyle = '#111111';
        ctx.fillStyle = '#111111';
        ctx.globalAlpha = 1;
        if (kind === 'marker') {
          ctx.lineCap = 'square';
          ctx.lineJoin = 'miter';
          ctx.lineWidth = 8;
        } else if (kind === 'ink') {
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.lineWidth = 6;
        } else {
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.lineWidth = 1.5;
        }
      }

      function sizeCanvas() {
        const ratio = window.devicePixelRatio || 1;
        const width = window.innerWidth;
        const height = window.innerHeight;
        canvas.width = Math.floor(width * ratio);
        canvas.height = Math.floor(height * ratio);
        canvas.style.width = width + 'px';
        canvas.style.height = height + 'px';
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
        styleLine(brush);
      }

      const WORLD = 2000;

      function viewFit() {
        const w = window.innerWidth || 1;
        const h = window.innerHeight || 1;
        const scale = Math.max(w / WORLD, h / WORLD);
        return {
          scale: scale,
          ox: (w - WORLD * scale) / 2,
          oy: (h - WORLD * scale) / 2,
        };
      }

      function px(p) {
        const fit = viewFit();
        return {
          x: p.x * WORLD * fit.scale + fit.ox,
          y: p.y * WORLD * fit.scale + fit.oy,
        };
      }

      function toNorm(p) {
        const fit = viewFit();
        const span = WORLD * fit.scale || 1;
        return {
          x: (p.x - fit.ox) / span,
          y: (p.y - fit.oy) / span,
        };
      }

      function drawStar(x, y, r) {
        ctx.beginPath();
        for (let i = 0; i < 8; i++) {
          const rad = (Math.PI / 4) * i - Math.PI / 2;
          const len = i % 2 === 0 ? r : r * 0.38;
          const sx = x + Math.cos(rad) * len;
          const sy = y + Math.sin(rad) * len;
          if (i === 0) ctx.moveTo(sx, sy);
          else ctx.lineTo(sx, sy);
        }
        ctx.closePath();
        ctx.fill();
      }

      function drawSplat(x, y, seedX, seedY) {
        for (let i = 0; i < 8; i++) {
          const a = hash(seedX, seedY, i) * Math.PI * 2;
          const d = 2 + hash(seedX, seedY, i + 9) * 7;
          const r = 2 + hash(seedX, seedY, i + 17) * 4;
          ctx.beginPath();
          ctx.arc(x + Math.cos(a) * d, y + Math.sin(a) * d, r, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      function drawBloom(x, y) {
        for (let i = 0; i < 5; i++) {
          const a = (Math.PI * 2 * i) / 5 - Math.PI / 2;
          ctx.beginPath();
          ctx.ellipse(
            x + Math.cos(a) * 5,
            y + Math.sin(a) * 5,
            3.4,
            2.2,
            a,
            0,
            Math.PI * 2
          );
          ctx.fill();
        }
        ctx.beginPath();
        ctx.arc(x, y, 2.1, 0, Math.PI * 2);
        ctx.fill();
      }

      function stampAt(kind, x, y, seedX, seedY) {
        if (kind === 'nib') {
          ctx.save();
          ctx.translate(x, y);
          ctx.rotate(-Math.PI / 4);
          ctx.beginPath();
          ctx.ellipse(0, 0, 9, 1.8, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
          return;
        }
        if (kind === 'chalk') {
          for (let i = 0; i < 10; i++) {
            const dx = (hash(seedX, seedY, i) - 0.5) * 8;
            const dy = (hash(seedX, seedY, i + 11) - 0.5) * 8;
            ctx.globalAlpha = 0.22 + hash(seedX, seedY, i + 23) * 0.25;
            ctx.beginPath();
            ctx.arc(x + dx, y + dy, 1.2 + hash(seedX, seedY, i + 31) * 1.8, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.globalAlpha = 1;
          return;
        }
        if (kind === 'spray') {
          for (let i = 0; i < 16; i++) {
            const a = hash(seedX, seedY, i) * Math.PI * 2;
            const d = hash(seedX, seedY, i + 40) * 13;
            ctx.globalAlpha = 0.18 + hash(seedX, seedY, i + 7) * 0.45;
            ctx.beginPath();
            ctx.arc(x + Math.cos(a) * d, y + Math.sin(a) * d, 0.6 + hash(seedX, seedY, i + 19) * 1.1, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.globalAlpha = 1;
          return;
        }
        if (kind === 'dots') {
          ctx.beginPath();
          ctx.arc(x, y, 3.2, 0, Math.PI * 2);
          ctx.fill();
          return;
        }
        if (kind === 'stars') {
          drawStar(x, y, 6);
          return;
        }
        if (kind === 'splat') {
          drawSplat(x, y, seedX, seedY);
          return;
        }
        if (kind === 'bloom') {
          drawBloom(x, y);
          return;
        }
        if (kind === 'two') {
          ctx.font = '18px "Times New Roman", Times, serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText('2', x, y);
        }
      }

      function isLineBrush(kind) {
        return kind === 'pencil' || kind === 'ink' || kind === 'marker';
      }

      function drawStroke(raw) {
        const stroke = Array.isArray(raw)
          ? { brush: 'pencil', points: raw }
          : { brush: raw.brush || 'pencil', points: raw.points || [] };
        const points = stroke.points;
        if (!points.length) return;
        const kind = stroke.brush || 'pencil';
        styleLine(kind);

        if (isLineBrush(kind)) {
          if (points.length === 1) {
            const p = px(points[0]);
            ctx.beginPath();
            ctx.arc(p.x, p.y, kind === 'marker' ? 4 : kind === 'ink' ? 3 : 0.8, 0, Math.PI * 2);
            ctx.fill();
            return;
          }
          ctx.beginPath();
          const first = px(points[0]);
          ctx.moveTo(first.x, first.y);
          for (let i = 1; i < points.length; i++) {
            const p = px(points[i]);
            ctx.lineTo(p.x, p.y);
          }
          ctx.stroke();
          return;
        }

        for (let i = 0; i < points.length; i++) {
          const p = px(points[i]);
          stampAt(kind, p.x, p.y, points[i].x, points[i].y);
        }
      }

      function redraw() {
        sizeCanvas();
        savedStrokes.forEach(drawStroke);
        unsavedStrokes.forEach(drawStroke);
        if (currentStroke) drawStroke(currentStroke);
      }

      function point(event) {
        if (event.touches && event.touches[0]) {
          return { x: event.touches[0].clientX, y: event.touches[0].clientY };
        }
        return { x: event.clientX, y: event.clientY };
      }

      function showSave() {
        saveBtn.hidden = unsavedStrokes.length === 0;
        saveBtn.textContent = 'save';
        saveBtn.disabled = false;
      }

      function start(event) {
        if (event.target !== canvas) return;
        event.preventDefault();
        const p = point(event);
        drawing = true;
        lastX = p.x;
        lastY = p.y;
        lastStampX = p.x;
        lastStampY = p.y;
        currentStroke = { brush: brush, points: [toNorm(p)] };
        styleLine(brush);
        if (!isLineBrush(brush)) {
          stampAt(brush, p.x, p.y, currentStroke.points[0].x, currentStroke.points[0].y);
        } else {
          ctx.beginPath();
          ctx.arc(p.x, p.y, brush === 'marker' ? 4 : brush === 'ink' ? 3 : 0.8, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      function move(event) {
        if (!drawing || !currentStroke) return;
        event.preventDefault();
        const p = point(event);
        const n = toNorm(p);
        if (isLineBrush(brush)) {
          ctx.beginPath();
          ctx.moveTo(lastX, lastY);
          ctx.lineTo(p.x, p.y);
          ctx.stroke();
          currentStroke.points.push(n);
        } else {
          const gap = stampGap[brush] || 10;
          const dx = p.x - lastStampX;
          const dy = p.y - lastStampY;
          if (Math.hypot(dx, dy) >= gap) {
            stampAt(brush, p.x, p.y, n.x, n.y);
            currentStroke.points.push(n);
            lastStampX = p.x;
            lastStampY = p.y;
          }
        }
        lastX = p.x;
        lastY = p.y;
      }

      function stop() {
        if (!drawing) return;
        drawing = false;
        if (currentStroke && currentStroke.points.length) {
          unsavedStrokes.push(currentStroke);
          showSave();
        }
        currentStroke = null;
      }

      document.querySelectorAll('.brush-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          brush = btn.getAttribute('data-brush');
          document.querySelectorAll('.brush-btn').forEach(function (el) {
            el.classList.toggle('is-active', el === btn);
          });
          styleLine(brush);
        });
      });

      async function loadWall() {
        try {
          const res = await fetch('/graffiti');
          const data = await res.json();
          savedStrokes = Array.isArray(data.strokes) ? data.strokes : [];
        } catch (_err) {
          savedStrokes = [];
        }
        redraw();
      }

      saveBtn.addEventListener('click', async function () {
        if (!unsavedStrokes.length || saveBtn.disabled) return;
        saveBtn.disabled = true;
        saveBtn.textContent = 'saving';
        try {
          const res = await fetch('/graffiti', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ strokes: unsavedStrokes }),
          });
          if (!res.ok) throw new Error('save failed');
          savedStrokes = savedStrokes.concat(unsavedStrokes);
          unsavedStrokes = [];
          saveBtn.hidden = true;
          saveBtn.textContent = 'save';
        } catch (_err) {
          saveBtn.textContent = 'retry';
        }
        saveBtn.disabled = false;
      });

      window.addEventListener('resize', redraw);
      canvas.addEventListener('mousedown', start);
      canvas.addEventListener('mousemove', move);
      window.addEventListener('mouseup', stop);
      canvas.addEventListener('touchstart', start, { passive: false });
      canvas.addEventListener('touchmove', move, { passive: false });
      window.addEventListener('touchend', stop);
      window.addEventListener('touchcancel', stop);

      loadWall();
    })();
  </script>
</body>
</html>
