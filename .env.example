# Copy this file to .env for local development.
# On Railway, set these under your service's "Variables" tab instead —
# do not commit a real .env file.

# A long random string used to sign session cookies.
SESSION_SECRET=change-this-to-something-long-and-random

# First admin account (created automatically on first boot).
ADMIN1_USERNAME=admin1
ADMIN1_PASSWORD=change-me
ADMIN1_NAME=Admin One

# Second admin account.
ADMIN2_USERNAME=admin2
ADMIN2_PASSWORD=change-me-too
ADMIN2_NAME=Admin Two

PORT=3000

# On Railway, also set:
# DATA_DIR=/data
# DB_PATH=/data/data.sqlite
